{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lovspor legislative crosswalk record — PROPOSED v0.2 draft (owner approval required)",
  "description": "PROPOSED, not accepted. A draft that makes the decisions proposed in docs/proposals/legislative-crosswalk-decisions-proposal-2026-11-02.md concrete: source pins, parsed identity, per-edge status, record revisions and withdrawal, typed correction evidence. It does not replace legislative-crosswalk-v0.schema.json, which Politik PR #178 reads. Structure is not verification of primary-source bytes, origin or rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_state",
    "amending_lov_id",
    "record_revision",
    "record_state",
    "observed_on",
    "status",
    "edge_status",
    "decision",
    "sak_id",
    "sanction_events",
    "evidence",
    "source_pins"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0-proposal"
    },
    "release_state": {
      "description": "No 'released' state exists in this draft. Adding one is an owner decision and a schema version bump.",
      "enum": [
        "research_only",
        "release_candidate"
      ]
    },
    "amending_lov_id": {
      "$ref": "#/$defs/law_id"
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "record_state": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ]
    },
    "supersedes_revision": {
      "type": "integer",
      "minimum": 1
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawn_on",
        "reason"
      ],
      "properties": {
        "withdrawn_on": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observed_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "edge_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "law_decision",
        "decision_case"
      ],
      "properties": {
        "law_decision": {
          "$ref": "#/$defs/status"
        },
        "decision_case": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "enum": [
        "decision_kind_not_supported",
        "no_decision_citation_in_source",
        "law_not_in_pinned_archives",
        "multiple_candidates",
        "source_disagreement",
        "rights_not_established",
        "other"
      ]
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "sak_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "sanction_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sanction_event"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "source_pins": {
      "$ref": "#/$defs/source_pins"
    }
  },
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "law_id": {
      "type": "string",
      "pattern": "^LOV-[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$"
    },
    "status": {
      "enum": [
        "reviewed_web_only",
        "attested",
        "unresolved",
        "ambiguous",
        "contradicted",
        "unsupported"
      ]
    },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:www\\.)?(?:stortinget\\.no|data\\.stortinget\\.no|regjeringen\\.no|lovdata\\.no|api\\.lovdata\\.no)/"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session_id",
        "number"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lovvedtak",
            "besl_o"
          ]
        },
        "session_id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sanction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "law_id",
        "kind",
        "source_url"
      ],
      "properties": {
        "law_id": {
          "$ref": "#/$defs/law_id"
        },
        "kind": {
          "description": "unclassified_sanction: a source-backed sanction whose initial/corrective role no permitted source states (the #618 case as read from Lovtidend headers).",
          "enum": [
            "initial_sanction",
            "corrective_resanction",
            "unclassified_sanction"
          ]
        },
        "source_url": {
          "$ref": "#/$defs/official_url"
        },
        "corrects_law_id": {
          "$ref": "#/$defs/law_id"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "corrective_resanction"
          }
        }
      },
      "then": {
        "required": [
          "corrects_law_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "corrects_law_id"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "source_url",
        "capture_level",
        "observed_on"
      ],
      "properties": {
        "role": {
          "enum": [
            "law_identity",
            "law_decision_pair",
            "decision_case",
            "correction"
          ]
        },
        "source_url": {
          "$ref": "#/$defs/official_url"
        },
        "capture_level": {
          "enum": [
            "web_page_review",
            "raw_body_captured"
          ]
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "upstream_id": {
          "type": "string",
          "minLength": 1
        },
        "body_sha256": {
          "description": "Provenance: which bytes this run read. Not the comparison key across captures.",
          "$ref": "#/$defs/sha256"
        },
        "parsed_identity_sha256": {
          "description": "Comparison key: SHA-256 of the canonical JSON of the identity the named parser extracted.",
          "$ref": "#/$defs/sha256"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capture_level": {
                "const": "raw_body_captured"
              }
            }
          },
          "then": {
            "required": [
              "upstream_id",
              "body_sha256",
              "parsed_identity_sha256",
              "retrieved_at",
              "parser_version"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "body_sha256"
                  ]
                },
                {
                  "required": [
                    "parsed_identity_sha256"
                  ]
                },
                {
                  "required": [
                    "retrieved_at"
                  ]
                },
                {
                  "required": [
                    "parser_version"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "law_identity"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "pattern": "^https://api\\.lovdata\\.no/v1/publicData/"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "decision_case"
              },
              "capture_level": {
                "const": "raw_body_captured"
              }
            },
            "required": [
              "role",
              "capture_level"
            ]
          },
          "then": {
            "properties": {
              "source_url": {
                "pattern": "^https://data\\.stortinget\\.no/eksport/sak\\?"
              }
            }
          }
        }
      ]
    },
    "lovdata_archive_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "source_url",
        "sha256",
        "size_bytes",
        "last_modified",
        "retrieved_at",
        "licence",
        "licence_basis"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^lovtidend-avd1-(?:2001-2025|[0-9]{4})\\.tar\\.bz2$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://api\\.lovdata\\.no/v1/publicData/get/lovtidend-avd1-"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "last_modified": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "licence": {
          "const": "NLOD-2.0"
        },
        "licence_basis": {
          "description": "stated_for_file: a Lovdata or data.norge.no statement names this file under NLOD 2.0. inferred_same_dataset: only the dataset description matches; not sufficient for a release candidate.",
          "enum": [
            "stated_for_file",
            "inferred_same_dataset"
          ]
        }
      }
    },
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lovverk_commit",
        "producer_commit",
        "parsers",
        "lovdata_archives"
      ],
      "properties": {
        "lovverk_commit": {
          "$ref": "#/$defs/git_sha"
        },
        "producer_commit": {
          "$ref": "#/$defs/git_sha"
        },
        "parsers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lovtidend",
            "stortinget_sak"
          ],
          "properties": {
            "lovtidend": {
              "type": "string",
              "minLength": 1
            },
            "stortinget_sak": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "lovdata_archives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lovdata_archive_pin"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_revision": {
            "minimum": 2
          }
        }
      },
      "then": {
        "required": [
          "supersedes_revision"
        ]
      },
      "else": {
        "not": {
          "required": [
            "supersedes_revision"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_state": {
            "const": "withdrawn"
          }
        }
      },
      "then": {
        "required": [
          "withdrawal"
        ]
      },
      "else": {
        "not": {
          "required": [
            "withdrawal"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unresolved",
              "ambiguous",
              "contradicted",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason",
          "reason_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "besl_o"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "unsupported"
          },
          "reason_code": {
            "const": "decision_kind_not_supported"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sanction_events": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "corrective_resanction"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        },
        "required": [
          "sanction_events"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "role": {
                  "const": "correction"
                }
              },
              "required": [
                "role"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {
            "const": "release_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "source_pins": {
            "properties": {
              "lovdata_archives": {
                "items": {
                  "properties": {
                    "licence_basis": {
                      "const": "stated_for_file"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "attested"
          }
        }
      },
      "then": {
        "properties": {
          "edge_status": {
            "properties": {
              "law_decision": {
                "const": "attested"
              },
              "decision_case": {
                "const": "attested"
              }
            }
          },
          "decision": {
            "$ref": "#/$defs/decision"
          },
          "sak_id": {
            "type": "integer",
            "minimum": 1
          },
          "sanction_events": {
            "minItems": 1
          },
          "source_pins": {
            "properties": {
              "lovdata_archives": {
                "minItems": 1
              }
            }
          },
          "evidence": {
            "minItems": 3,
            "allOf": [
              {
                "contains": {
                  "required": [
                    "role",
                    "capture_level"
                  ],
                  "properties": {
                    "role": {
                      "const": "law_identity"
                    },
                    "capture_level": {
                      "const": "raw_body_captured"
                    }
                  }
                }
              },
              {
                "contains": {
                  "required": [
                    "role",
                    "capture_level"
                  ],
                  "properties": {
                    "role": {
                      "const": "law_decision_pair"
                    },
                    "capture_level": {
                      "const": "raw_body_captured"
                    }
                  }
                }
              },
              {
                "contains": {
                  "required": [
                    "role",
                    "capture_level"
                  ],
                  "properties": {
                    "role": {
                      "const": "decision_case"
                    },
                    "capture_level": {
                      "const": "raw_body_captured"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
