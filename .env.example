# Copy to .env and adjust. .env is gitignored.

# Local cache for downloaded tarballs and extracted XML (gitignored)
LOVSPOR_DATA_DIR=./data
LOVSPOR_CACHE_DIR=./data/cache

# Where rendered Markdown is written. Defaults to sibling lovverk repo.
LOVSPOR_OUTPUT_REPO_PATH=../lovverk

# Git commit mode for the lovverk corpus: per-document | single
LOVSPOR_GIT_COMMIT_MODE=per-document

# HTTP behavior
LOVSPOR_HTTP_TIMEOUT_SECONDS=120
LOVSPOR_HTTP_USER_AGENT=lovspor/0.1 (+https://github.com/bartoszkobylinski/lovspor)

# Logging: DEBUG | INFO | WARNING | ERROR
LOVSPOR_LOG_LEVEL=INFO

# OpenAI key for text-embedding-3-large. Required for the engine sync to
# write per-section embeddings AND for the MCP server's semantic_search
# tool. Without it the sync still renders Markdown and the other MCP tools
# work, but semantic_search is disabled. OPENAI_APIKEY (no underscore) is
# accepted as a fallback.
OPENAI_API_KEY=sk-...

# Embedding provider selection. Every one of these is optional: leaving them
# unset gives the OpenAI adapter with text-embedding-3-large at 3072 dims,
# which is what the published lovverk sidecars were built with.
#
# WARNING: configuring a different embedding space disables semantic_search
# against the published corpus. Sidecars record only their dimension, never
# which model wrote them, so compatibility cannot be verified for any space
# other than the default — and comparing vectors across spaces returns
# confident nonsense rather than an error. See docs/embeddings.md.
# openai is currently the only supported provider; an unknown value is an
# error, never a silent fallback to a different one.
# LOVSPOR_EMBEDDING_PROVIDER=openai
# LOVSPOR_EMBEDDING_MODEL=text-embedding-3-large
# LOVSPOR_EMBEDDING_DIMENSION=3072
# LOVSPOR_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
# LOVSPOR_EMBEDDING_API_KEY=sk-...

# Path to a local clone of the lovverk corpus, read by `lovspor mcp`.
LOVVERK_CORPUS_PATH=../lovverk
