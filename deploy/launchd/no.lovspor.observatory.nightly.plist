<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly observatory sweep (issue #167).

  Template. Replace every __PLACEHOLDER__ before loading; see
  docs/operations.md, "Observatory: the 24-hour observation SLA".

  StartCalendarInterval rather than cron on purpose: if the machine is asleep
  at the scheduled time launchd runs the job on wake, and several missed
  triggers coalesce into one. cron simply loses them.

  A machine powered off at the scheduled time is different: launchd replays
  nothing at boot, and the trigger is lost (issue #356). RunAtLoad covers it —
  the job runs when this agent loads at login — and the catch-up flag keeps
  that load from starting a second sweep when one started in the last 24 hours.
  The 03:00 trigger itself is never guarded; see
  src/lovspor/observatory/catch_up.py.

  The hour lives here and nowhere else. How often a source must be observed is
  a property of the data and is stated once, in
  src/lovspor/observatory/sweeps.py; which hour the job fires is deployment
  configuration.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>no.lovspor.observatory.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>__LOVSPOR_BIN__</string>
        <string>observatory</string>
        <string>nightly</string>
        <string>--catch-up</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- No default anywhere in the engine: the archive must be named, so
             that a forgotten variable fails loudly instead of writing
             observed material somewhere it does not belong (ADR-0010 §5). -->
        <key>LOVSPOR_OBSERVATORY_ROOT</key>
        <string>__OBSERVATORY_ROOT__</string>

        <!-- The outbound half of the dead-man switch. Unset means no switch is
             armed, and the sweep says so on stderr rather than passing
             quietly — silence is the failure this whole mechanism exists to
             make audible. -->
        <key>LOVSPOR_OBSERVATORY_HEARTBEAT_URL</key>
        <string>__HEARTBEAT_URL__</string>

        <!-- Refuse to sweep from an engine checkout that is on a branch or
             dirty (issue #219). The nightly worktree is meant to sit detached
             on a merged commit; a stray checkout must read as a red run. -->
        <key>LOVSPOR_OBSERVATORY_REQUIRE_PINNED_ENGINE</key>
        <string>1</string>

        <!-- Capture selection (issue #348) is deliberately absent: off by
             default, switched on only after one measured pass, by adding
             LOVSPOR_OBSERVATORY_CAPTURE_SELECTION=1 here. See
             docs/operations.md, "Selecting what to capture by path". -->
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- At load, to catch up a 03:00 the machine was powered off for (issue
         #356). Guarded by the catch-up flag: a load within 24 hours of a
         sweep's start exits without sweeping, so a reboot after a run does
         not start a second one. A load with no sweep in the last 24 hours -
         including `launchctl bootstrap` during setup - DOES start a sweep:
         that is a missed night, and catching it up is the point. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/observatory-nightly.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/observatory-nightly.err.log</string>

    <!-- The sweep is polite by construction — every host waits out its own
         rate limit — so it must not also compete for CPU with whatever the
         machine is doing. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
