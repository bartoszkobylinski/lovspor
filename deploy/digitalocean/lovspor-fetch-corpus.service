[Unit]
Description=Refresh the local lovverk corpus clone
Documentation=https://github.com/bartoszkobylinski/lovspor/blob/main/deploy/digitalocean/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lovspor
Group=lovspor
Environment=HOME=/opt/lovspor
Environment=LOVVERK_CORPUS_PATH=/opt/lovspor/.cache/lovverk
WorkingDirectory=/opt/lovspor/app
# --full-history: the hosted MCP exposes the time-machine tools, which walk
# git log; a shallow checkout would silently limit them to post-clone dates
# and make get_law_at misreport pre-clone corpus states (ADR-0003).
ExecStart=/opt/lovspor/app/.venv/bin/lovspor fetch-corpus --full-history
# oneshot disables the start timeout by default; bound it so a stalled git fetch
# cannot wedge the unit and block every subsequent timer run.
TimeoutStartSec=600
# No mcp restart needed: the running reader drops every cache when manifest.json
# changes (_refresh_if_stale) and rebuilds indices on the next query.
