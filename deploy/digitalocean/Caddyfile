# lovspor hosted MCP — TLS terminated here, proxied to the localhost-bound app.
#
# {$LOVSPOR_DOMAIN} is read from Caddy's environment (see the caddy.service
# drop-in that provision.sh installs, sourcing /etc/default/caddy-lovspor).
# On a public droplet Caddy AUTOMATICALLY obtains and renews a Let's Encrypt
# certificate for this name on first request, once DNS points the name here —
# no certbot, no cron, no manual cert steps.

# Caddy's admin API is what makes a release live (`caddy reload`) and the only
# thing that can say what is actually being served, so the release procedure
# trusts it the way it trusts nothing on disk. On the default localhost:2019
# every process on the box — the app's own user included — can rewrite the
# running configuration without touching a file. Bound to a Unix socket
# created 0660 in the release group instead, only that group and root can
# (ADR-0014 Decision 6). The |0660 suffix is part of the address, not a
# comment on it: it is the mode Caddy creates the socket with, and without it
# the mode comes from the umask and the group restricts nothing.
{
	admin unix//run/caddy/admin.sock|0660
}

{$LOVSPOR_DOMAIN} {
	encode zstd gzip

	# MCP app + health probes + OAuth discovery → the localhost-bound server
	# (TLS stops here).
	#
	# The .well-known path MUST be proxied rather than left to the landing page.
	# It is the RFC 9728 protected-resource document that tells an OAuth client
	# which authorization server to use, and the app serves it only when hosted
	# OAuth is configured. Omitting it fails in the most confusing way available:
	# the app answers 200 on localhost while the public URL 404s from file_server,
	# so every connector reports "cannot authenticate" against a server that looks
	# perfectly healthy from every other angle.
	@app path /mcp /mcp/* /healthz /readyz /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @app {
		reverse_proxy 127.0.0.1:8000 {
			# STOPGAP — remove once the app configures TransportSecuritySettings.
			#
			# The MCP SDK auto-enables DNS-rebinding protection whenever the server
			# binds 127.0.0.1, allowing ONLY localhost Host headers
			# (mcp/server/fastmcp/server.py: allowed_hosts=["127.0.0.1:*", ...]).
			# A proxied request arrives with the public hostname, which is not on
			# that list, so every authenticated /mcp call answered 421 Misdirected
			# Request — for opaque tokens as well as OAuth. Health probes are
			# custom_route and bypass the check, which is why every probe said the
			# service was fine while the actual tool surface was unreachable.
			#
			# Rewriting Host to the upstream address satisfies the check, but it
			# satisfies it by making the guard trivially true rather than by
			# configuring it. The real fix is passing allowed_hosts=[public host]
			# to FastMCP so the check still rejects unexpected Host headers.
			header_up Host {upstream_hostport}
		}
	}

	# The corpus (ADR-0013) and the site → the active release fragment, which
	# `lovspor release commit` renames into place. Every path in it names one
	# immutable release directory — pages, redirect map and site tree from the
	# same build — and it declares the release id as a var, so what Caddy is
	# serving can be read back from the admin API. This file names no release
	# directory of its own, which is what makes a release a rename plus a reload
	# rather than an edit here.
	#
	# Deliberately not a glob. A glob that matches nothing leaves the site block
	# empty and every request 404s with no error recorded anywhere; a plain
	# import of a missing file is a hard `caddy validate` failure, which is the
	# right reading of "no release is published". So this file must not reach
	# /etc/caddy before a fragment reaches that path: on a fresh box
	# `provision.sh` writes a placeholder fragment in the same step, and on a
	# box already serving, installing this file is a step of `lovspor release
	# migrate` (ADR-0014 Migration) — never a hand copy either way. The env
	# placeholder lets `caddy validate` and `caddy adapt` compose the NEXT
	# release's fragment before it is renamed into place; at runtime the
	# variable is unset and the default applies.
	import {$LOVSPOR_RELEASE_FRAGMENT:/etc/caddy/lovspor-release.caddy}

	header {
		# HSTS: only meaningful once you're confident the domain is HTTPS-only.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /var/log/caddy/lovspor.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
