{
 "seal_script_pushes": [
  "git -C \"$repo\" push -q origin \"refs/tags/$SEAL_TAG\""
 ],
 "workflow_secrets": {
  "embedding-cache-staging.yml": [
   "R2_ACCESS_KEY_ID",
   "R2_ACCOUNT_ID",
   "R2_SECRET_ACCESS_KEY"
  ],
  "mutation-remediation.yml": [
   "CLAUDE_TESTS_OAUTH_TOKEN",
   "GITHUB_TOKEN",
   "LOVSPOR_CI_PUSH_TOKEN"
  ],
  "nightly-mutation.yml": [
   "GITHUB_TOKEN"
  ],
  "pr-pipeline.yml": [
   "CLAUDE_TESTS_OAUTH_TOKEN",
   "GITHUB_TOKEN",
   "LOVSPOR_CI_PUSH_TOKEN"
  ],
  "sync.yml": [
   "LOVVERK_DEPLOY_KEY",
   "LOVVERK_SEAL_SIGNING_KEY",
   "OPENAI_API_KEY"
  ],
  "token-expiry.yml": [
   "LOVSPOR_CI_PUSH_TOKEN"
  ],
  "verify-lovverk-key.yml": [
   "LOVVERK_DEPLOY_KEY"
  ]
 },
 "workflows": {
  "sync.yml": {
   "concurrency": {
    "cancel-in-progress": false,
    "group": "sync"
   },
   "defaults": null,
   "env_secrets": [],
   "jobs": {
    "seal": {
     "actions": [
      "actions/checkout",
      "actions/download-artifact"
     ],
     "checkouts": [
      {
       "persist-credentials": false,
       "sparse-checkout": "scripts/seal/sign-and-tag.sh\nops/publication-signers\n",
       "sparse-checkout-cone-mode": false
      }
     ],
     "container": null,
     "environment": "lovverk-seal",
     "if": "${{ !cancelled() && needs.sync.outputs.seal_state == 'composed' && needs.sync.outputs.published == 'true' }}",
     "matrix": null,
     "needs": "sync",
     "permissions": {
      "contents": "read",
      "issues": "write"
     },
     "pushes": [],
     "runs-on": "ubuntu-latest",
     "scripts": [
      "scripts/seal/sign-and-tag.sh"
     ],
     "secrets": [
      "LOVVERK_DEPLOY_KEY",
      "LOVVERK_SEAL_SIGNING_KEY"
     ],
     "uses": null,
     "variables": [
      "LOVVERK_SEAL_REQUIRED"
     ]
    },
    "sync": {
     "actions": [
      "actions/checkout",
      "actions/upload-artifact",
      "astral-sh/setup-uv"
     ],
     "checkouts": [
      {}
     ],
     "container": null,
     "environment": "lovverk-sync",
     "if": null,
     "matrix": null,
     "needs": null,
     "permissions": null,
     "pushes": [
      "git push origin main",
      "git push origin refs/notes/temporal-attestations"
     ],
     "runs-on": "ubuntu-latest",
     "scripts": [],
     "secrets": [
      "LOVVERK_DEPLOY_KEY",
      "OPENAI_API_KEY"
     ],
     "uses": null,
     "variables": [
      "LOVVERK_SEAL_REQUIRED"
     ]
    }
   },
   "permissions": {
    "contents": "read",
    "issues": "write"
   },
   "pushes": [
    "git push origin main",
    "git push origin refs/notes/temporal-attestations"
   ],
   "secrets": [
    "LOVVERK_DEPLOY_KEY",
    "LOVVERK_SEAL_SIGNING_KEY",
    "OPENAI_API_KEY"
   ],
   "triggers": {
    "schedule": [
     "0 4 * * *"
    ],
    "workflow_dispatch": {
     "inputs": {
      "repair_embeddings": {
       "default": false,
       "type": "boolean"
      }
     }
    }
   }
  },
  "verify-lovverk-key.yml": {
   "concurrency": null,
   "defaults": null,
   "env_secrets": [],
   "jobs": {
    "verify": {
     "actions": [],
     "checkouts": [],
     "container": null,
     "environment": "${{ matrix.environment }}",
     "if": "github.ref == 'refs/heads/main'",
     "matrix": {
      "environment": [
       "lovverk-sync",
       "lovverk-seal"
      ]
     },
     "needs": null,
     "permissions": null,
     "pushes": [
      "git -C \"$probe\" push --dry-run --porcelain \"$LOVVERK_URL\" \"HEAD:$PROBE_REF\""
     ],
     "runs-on": "ubuntu-latest",
     "scripts": [],
     "secrets": [
      "LOVVERK_DEPLOY_KEY"
     ],
     "uses": null,
     "variables": []
    }
   },
   "permissions": {},
   "pushes": [
    "git -C \"$probe\" push --dry-run --porcelain \"$LOVVERK_URL\" \"HEAD:$PROBE_REF\""
   ],
   "secrets": [
    "LOVVERK_DEPLOY_KEY"
   ],
   "triggers": {
    "workflow_dispatch": {
     "inputs": {}
    }
   }
  }
 }
}
