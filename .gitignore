# Local data — never commit (see CLAUDE.md and docs/legal-and-sources.md)
data/cache/
data/raw/
data/state/
*.tar.bz2
*.tar.gz

# Internal working notes — audits, backlogs, personal outreach notes. Never publish.
analysis/
notes/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# LLHB runner: per-run CLI sandbox HOME (never versioned; records/raw ARE versioned)
benchmarks/llhb/results/runs/.sandbox/
# LLHB runs retrieve statutory text, and legal text does not live in this repo
# (CLAUDE.md). These directories exist on disk after any pilot run, so without
# the rule here every branch cut from main re-exposes them to `git add -A` —
# which is exactly how they reached a review branch once.
benchmarks/llhb/results/runs/*/tools/
benchmarks/llhb/results/runs/*/raw/
